NEWS_TZ=America/Sao_Paulo
NEWS_TIMEZONE_LABEL=Horário de Brasília
DRY_RUN=true

OPENAI_API_KEY=
ALLOW_NO_OPENAI=false
OPENAI_RANK_MODEL=gpt-5.4-mini
OPENAI_SUMMARY_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low

EMAIL_FROM=ryandpaulosantos@gmail.com
EMAIL_TO=ryandpaulosantos@gmail.com,leticiamariadiasfreitas@gmail.com
EMAIL_TRANSPORT=gmailr

GMAILR_KEY=
GMAILR_TOKEN_ENC_B64=
GMAIL_OAUTH_CLIENT=oauth_client.json
GMAIL_TOKEN_PATH=secrets/gmailr-token.rds
GMAIL_ENCRYPTED_TOKEN_PATH=secrets/gmailr-token.rds.enc

NEWS_MIN_SCORE=55
NEWS_SOURCE_MIN_SCORE=40
NEWS_MIN_NEWS_PER_SOURCE=1
NEWS_PER_SOURCE=4
MAX_SELECTED_NEWS=16
MAX_CANDIDATES_PER_SOURCE=60
J3_MAX_PAGES=20
IFF_MAX_PAGES=5
UENF_MAX_PAGES=5
CNN_MAX_PUBLIC_PAGES=4
SOURCE_TIMEOUT_SECONDS=20
OUTPUT_DIR=outputs
